{
  "name": "arthurs-mall",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace=@arthurs-mall/web\" \"npm run dev --workspace=@arthurs-mall/api\"",
    "dev:web": "npm run dev --workspace=@arthurs-mall/web",
    "dev:api": "npm run dev --workspace=@arthurs-mall/api",
    "build": "npm run build --workspace=@arthurs-mall/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
